<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Edge-to-edge Material 3 base theme (dark variant) -->
    <style name="MainTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="p">false</item>
        <item name="android:colorAccent">#B6C4FF</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <item name="android:textColorPrimary">@android:color/primary_text_dark_nodisable</item>
        <item name="android:textColorSecondary">@android:color/secondary_text_dark_nodisable</item>
    </style>

</resources>
